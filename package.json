{
  "name": "conpera-switch",
  "version": "1.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node server/server.mjs\" \"vite --host 127.0.0.1 --port 4317 --strictPort\"",
    "build": "tsc -b && vite build",
    "build:mac": "npm run build && node scripts/build-mac.mjs",
    "preview": "node server/server.mjs",
    "test": "node --test server/auth.test.mjs",
    "test:native": "node scripts/test-native.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "build:mac:beta": "npm run build && node scripts/build-mac.mjs --beta",
    "test:configuration": "node scripts/test-configuration.mjs",
    "test:account": "node scripts/test-account.mjs",
    "test:beta-browser": "node scripts/verify-beta-browser.mjs",
    "build:mac:demo": "npm run build && node scripts/build-mac.mjs --demo",
    "package:mac": "npm run build:mac && node scripts/package-mac.mjs",
    "test:release-browser": "node scripts/verify-beta-browser.mjs --release",
    "test:settings-browser": "node scripts/verify-configuration-browser.mjs",
    "release:appcast": "node scripts/generate-appcast.mjs",
    "package:mac:release": "npm run package:mac && npm run release:appcast"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "playwright": "^1.58.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/conpera/conpera-switch.git"
  },
  "homepage": "https://github.com/conpera/conpera-switch"
}
